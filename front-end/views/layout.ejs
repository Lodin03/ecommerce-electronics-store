<!DOCTYPE html>
<html>
  <head>
    <title>E-Commerce Store - Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous"/>
  </head>
  <body>

    <!-- Main navbar -->
    <nav class="navbar navbar-dark bg-dark px-4">
      <span class="navbar-brand">Admin Panel</span>
      <form action="/logout" method="POST" class="d-inline">
        <button type="submit" class="btn btn-outline-light btn-sm">Logout</button>
      </form>
    </nav>

    <!-- Secondary nav -->
    <nav class="navbar navbar-expand bg-success-subtle px-3 border-bottom border-success">
      <ul class="navbar-nav gap-4">
        <li class="nav-item">
          <a href="/products" class="nav-link text-dark fw-semibold">Products</a>
        </li>
        <li class="nav-item">
          <a href="/categories" class="nav-link text-dark fw-semibold">Categories</a>
        </li>
        <li class="nav-item">
          <a href="/brands" class="nav-link text-dark fw-semibold">Brands</a>
        </li>
        <li class="nav-item">
          <a href="/orders" class="nav-link text-dark fw-semibold">Orders</a>
        </li>
        <li class="nav-item">
          <a href="/users" class="nav-link text-dark fw-semibold">Users</a>
        </li>
        <li class="nav-item">
          <a href="/memberships" class="nav-link text-dark fw-semibold">Memberships</a>
        </li>
      </ul>
    </nav>

    <!-- Main content -->
    <div class="container-fluid">
      <div class="row">
        <!-- Bootstrap uses a 12-column grid system. col-12 means this element takes all 12 columns for 100% width of the row. -->
        <main class="col-12 p-4"><%- body %></main>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>