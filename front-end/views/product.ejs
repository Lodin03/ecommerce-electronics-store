<h4 class="fw-bold mb-4">Products</h4>

<!-- Product search form: sends GET request to /products with query parameters -->
<form action="/products" method="GET" id="searchForm">
  <div class="row g-2 align-items-end mb-4">
    <!-- Search by name query -->
    <div class="col-3">
      <label class="form-label small fw-semibold">Name</label>
      <input type="text" id="nameInput" name="query" class="form-control" placeholder="Search by name..." value="<%= searchQuery %>" />
    </div>

    <!-- Category filter dropdown -->
    <div class="col-3">
      <label class="form-label small fw-semibold">Category</label>
      <select id="categoryInput" class="form-select">
        <option value="">All Categories</option>
        <% categories.forEach(function(cat) { %>
          <option value="<%= cat.name %>"><%= cat.name %></option>
        <% }); %>
      </select>
    </div>

     <!-- Brand filter dropdown -->
    <div class="col-3">
      <label class="form-label small fw-semibold">Brand</label>
      <select id="brandInput" class="form-select">
        <option value="">All Brands</option>
        <% brands.forEach(function(b) { %>
          <option value="<%= b.name %>"><%= b.name %></option>
        <% }); %>
      </select>
    </div>

   <!-- Submit search query or reset filters -->
    <div class="col-auto d-flex gap-2 align-items-end">
      <button type="submit" class="btn btn-success">Search</button>
      <a href="/products" class="btn btn-outline-secondary">Clear</a>
    </div>

    <!-- Button to add new product -->
    <div class="col-auto ms-auto d-flex align-items-end">
      <button type="button" class="btn btn-dark" data-bs-toggle="modal" data-bs-target="#addModal">+ Add</button>
    </div>

  </div>
</form>

<!-- If product exist: Display a table of all Product fields and their values (e.g. id, image, name etc.) -->
<% if (products && products.length > 0) { %>
  <table class="table table-hover align-middle">
    <thead class="table-dark">
      <tr>
        <th>ID</th>
        <th>Image</th>
        <th>Name</th>
        <th>Category</th>
        <th>Brand</th>
        <th>Price</th>
        <th>Quantity</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% products.forEach(function(product) { %>
        <tr>
          <td><%= product.id %></td>
          <td>
            <img src="<%= product.imgUrl %>" alt="<%= product.name %>" style="width: 40px; height: 40px; object-fit: contain;" />
          </td>
          <td><%= product.name %></td>
          <td><%= product.category %></td>
          <td><%= product.brand %></td>
          <td>$<%= product.unitPrice %></td>
          <td><%= product.quantity %></td>
          <td>
            <% if (product.isDeleted) { %>
              <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" checked disabled>
              </div>
            <% } else { %>
              <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" disabled>
              </div>
            <% } %>
          </td>
          <!-- Edit: Edit any value of a product -->
          <td class="d-flex gap-1">
            <button
              class="btn btn-sm btn-warning"
              data-bs-toggle="modal"
              data-bs-target="#editModal"
              data-id="<%= product.id %>"
              data-name="<%= product.name %>"
              data-description="<%= product.description || '' %>"
              data-price="<%= product.unitPrice %>"
              data-quantity="<%= product.quantity %>"
              data-imgurl="<%= product.imgUrl || '' %>"
              data-brandid="<%= product.brandId %>"
              data-categoryid="<%= product.categoryId %>"
              data-isdeleted="<%= product.isDeleted %>">
              Edit
            </button>
            <!-- 
              HTML forms only support GET and POST, no PUT/DELETE
              The frontend route then calls axios.delete() to the backend API 
            -->
            <!-- Sends POST request to delete a product (server performs soft delete by setting isDeleted = 1) -->
            <form action="/products/delete/<%= product.id %>" method="POST" class="d-inline">
              <button type="submit" class="btn btn-sm btn-danger">Delete</button>
            </form>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
<!-- If no products exist, display a fallback message -->
<% } else { %>
  <div class="alert alert-secondary">No products found.</div>
<% } %>

<!-- Add Product Modal -->
<div class="modal fade" id="addModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Add New Product</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <!-- Add product form: submits new product data via POST /products/add -->
      <form action="/products/add" method="POST">
        <div class="modal-body">

          <div class="mb-3">
            <label class="form-label small fw-semibold">Name</label>
            <input type="text" name="name" class="form-control" required />
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Description</label>
            <input type="text" name="description" class="form-control" />
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Price</label>
            <input type="number" name="unitPrice" class="form-control" step="0.01" required />
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Quantity</label>
            <input type="number" name="quantity" class="form-control" required />
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Image URL</label>
            <input type="text" name="imgUrl" class="form-control" placeholder="http://images.example.com/product.png" />
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Brand</label>
            <select name="brandId" class="form-select" required>
              <option value="">Select a brand</option>
              <% brands.forEach(function(b) { %>
                <option value="<%= b.id %>"><%= b.name %></option>
              <% }); %>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Category</label>
            <select name="categoryId" class="form-select" required>
              <option value="">Select a category</option>
              <% categories.forEach(function(cat) { %>
                <option value="<%= cat.id %>"><%= cat.name %></option>
              <% }); %>
            </select>
          </div>

        </div>
        <!-- Footer of modal: Submit new product or cancel the request -->
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-success">Add Product</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Edit Product Modal -->
<div class="modal fade" id="editModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Edit Product</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <!-- 
        HTML forms only support GET and POST, no PUT/DELETE
        The frontend route then calls axios.put() to the backend API -->
      <!-- Edit product form: submits updated product data via POST /products/edit/:id -->
      <form id="editForm" method="POST">
        <div class="modal-body">

          <div class="mb-3">
            <label class="form-label small fw-semibold">ID</label>
            <input type="text" id="editId" class="form-control" disabled />
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Name</label>
            <input type="text" name="name" id="editName" class="form-control" required />
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Description</label>
            <input type="text" name="description" id="editDescription" class="form-control" />
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Price</label>
            <input type="number" name="unitPrice" id="editPrice" class="form-control" step="0.01" required />
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Quantity</label>
            <input type="number" name="quantity" id="editQuantity" class="form-control" required />
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Image URL</label>
            <input type="text" name="imgUrl" id="editImgUrl" class="form-control" placeholder="http://images.example.com/product.png" />
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Brand</label>
            <select name="brandId" id="editBrand" class="form-select">
              <% brands.forEach(function(b) { %>
                <option value="<%= b.id %>"><%= b.name %></option>
              <% }); %>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Category</label>
            <select name="categoryId" id="editCategory" class="form-select">
              <% categories.forEach(function(cat) { %>
                <option value="<%= cat.id %>"><%= cat.name %></option>
              <% }); %>
            </select>
          </div>

          <div class="mb-3 form-check form-switch">
            <input type="checkbox" name="isDeleted" id="editIsDeleted" class="form-check-input" value="true" />
            <label class="form-check-label small fw-semibold">Soft Deleted</label>
          </div>

        </div>
        <!-- Footer of modal: Submit updated data or cancel the request -->
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-success">Save Changes</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  const nameInput = document.getElementById('nameInput');
  const categoryInput = document.getElementById('categoryInput');
  const brandInput = document.getElementById('brandInput');

  // When name is typed, reset dropdowns
  nameInput.addEventListener('input', function() {
    categoryInput.value = '';
    brandInput.value = '';
  });

  // When category is selected, reset name and brand
  categoryInput.addEventListener('change', function() {
    nameInput.value = '';
    brandInput.value = '';
  });

  // When brand is selected, reset name and category
  brandInput.addEventListener('change', function() {
    nameInput.value = '';
    categoryInput.value = '';
  });

  // Build search query from one active input and redirect to /products
  document.getElementById('searchForm').addEventListener('submit', function(e) {
    e.preventDefault();
    const query = nameInput.value.trim() || categoryInput.value.trim() || brandInput.value.trim();
    if (query) {
      window.location.href = '/products?query=' + encodeURIComponent(query);
    } else {
      window.location.href = '/products';
    }
  });

  // Populate edit modal fields using data attributes from selected product
  const editModal = document.getElementById('editModal');
  editModal.addEventListener('show.bs.modal', function(event) {
    const btn = event.relatedTarget;

    const id = btn.getAttribute('data-id');
    document.getElementById('editId').value = id;
    document.getElementById('editName').value = btn.getAttribute('data-name');
    document.getElementById('editDescription').value = btn.getAttribute('data-description');
    document.getElementById('editPrice').value = btn.getAttribute('data-price');
    document.getElementById('editQuantity').value = btn.getAttribute('data-quantity');
    document.getElementById('editImgUrl').value = btn.getAttribute('data-imgurl');
    document.getElementById('editBrand').value = btn.getAttribute('data-brandid');
    document.getElementById('editCategory').value = btn.getAttribute('data-categoryid');
    document.getElementById('editIsDeleted').checked = btn.getAttribute('data-isdeleted') === '1';

    document.getElementById('editForm').action = '/products/edit/' + id;
  });
</script>